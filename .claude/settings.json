{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer check)",
      "Bash(composer lint)",
      "Bash(composer analyse)",
      "Bash(composer test)",
      "Bash(composer test:*)",
      "Bash(composer fix)",
      "Bash(composer show:*)",
      "Bash(composer audit:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(php -l:*)",
      "Bash(npm run:*)",
      "Bash(npm view:*)",
      "Bash(npm ls:*)",
      "Bash(npm audit:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/rector:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/rector:*)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git ls-files:*)",
      "mcp__laravel-boost",
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate:fresh --seed)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:seed)",
      "Bash(php artisan permissions:sync)",
      "Bash(php artisan list:*)",
      "Bash(php artisan about)",
      "Bash(php artisan view:clear)",
      "Bash(php artisan config:clear)",
      "Bash(php artisan optimize:clear)",
      "Bash(php artisan lang:publish)",
      "Bash(php artisan scramble:export:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(php artisan migrate:fresh --env=production:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan tinker:*)",
      "Bash(php artisan config:show:*)",
      "Bash(php artisan env:*)",
      "Bash(cat .env:*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.backup)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-protected-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-edited-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
