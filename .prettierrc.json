{
    "printWidth": 120,
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-blade", "prettier-plugin-tailwindcss"],
    "overrides": [
        { "files": ["*.blade.php"], "options": { "parser": "blade", "printWidth": 120 } },
        { "files": ["*.json", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }
    ],
    "tailwindStylesheet": "./resources/css/app.css"
}
