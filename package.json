{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write --no-error-on-unmatched-pattern 'resources/**/*.{blade.php,js,css}' 'app/Modules/*/resources/**/*.blade.php'",
        "format:check": "prettier --check --no-error-on-unmatched-pattern 'resources/**/*.{blade.php,js,css}' 'app/Modules/*/resources/**/*.blade.php'"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.26.0",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.17.4",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "vazirmatn": "^33.0.3",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
