includes:
    - vendor/larastan/larastan/extension.neon

# Level max on everything we author. Vendor-published config and framework
# migrations are excluded (they are declarative and owned upstream) — ADR-0013.
parameters:
    level: max
    phpVersion: 80300
    paths:
        - app
        - bootstrap/app.php
        - database/seeders
        - routes
        - tools/phpstan/src
    tmpDir: storage/framework/cache/phpstan
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    reportUnmatchedIgnoredErrors: true

rules:
    - Tools\PHPStan\NoEloquentInControllersRule
