{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mohammadrasoulasghari/laravel-ai-sdk",
    "type": "project",
    "description": "An AI-first, modular Laravel 13 starter kit: architecture enforced by tests, static analysis and hooks so humans and AI coding agents ship consistent code.",
    "keywords": [
        "laravel",
        "starter-kit",
        "boilerplate",
        "modular",
        "ai",
        "claude-code",
        "agents",
        "blade",
        "rtl",
        "persian",
        "pest",
        "phpstan"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13.47",
        "hekmatinasser/verta": "^9.0",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/pennant": "^1.26",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/hook-installer": "^1.0",
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "laravel/telescope": "^5.25",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\PHPStan\\": "tools/phpstan/src/"
        },
        "files": [
            "tests/Support/helpers.php"
        ]
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --seed --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "pest --compact @additional_args"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php artisan starter:init"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --test",
            "rector process --dry-run --no-progress-bar",
            "npm run --silent format:check"
        ],
        "analyse": [
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100 --compact"
        ],
        "test:coverage": [
            "pest --coverage --min=80 --compact"
        ],
        "test:mutate": [
            "pest --mutate --everything --covered-only --parallel --min=80"
        ],
        "fix": [
            "rector process --no-progress-bar",
            "pint",
            "npm run --silent format"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "captainhook/hook-installer": true
        },
        "process-timeout": 900,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Install dependencies, create .env, migrate and seed, build assets.",
        "lint": "Check code style (Pint, Rector dry-run, Prettier) without changing files.",
        "analyse": "Run Larastan/PHPStan at level max.",
        "test": "Run the Pest test suite (unit, feature, arch).",
        "test:types": "Require 100% type coverage.",
        "test:coverage": "Run tests with line coverage (needs pcov or xdebug), min 80%.",
        "test:mutate": "Mutation testing for covered Actions and Value Objects.",
        "fix": "Apply Rector, Pint and Prettier fixes.",
        "check": "Everything CI runs: lint + analyse + test + type coverage. Must be green before done."
    },
    "homepage": "https://github.com/mohammadrasoulasghari/laravel-ai-sdk",
    "authors": [
        {
            "name": "Mohammad Rasoul Asghari",
            "homepage": "https://github.com/mohammadrasoulasghari"
        }
    ],
    "support": {
        "issues": "https://github.com/mohammadrasoulasghari/laravel-ai-sdk/issues",
        "source": "https://github.com/mohammadrasoulasghari/laravel-ai-sdk"
    }
}
