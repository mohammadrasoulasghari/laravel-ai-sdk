{
    "config": {
        "run-mode": "local",
        "ansi-colors": true,
        "fail-on-first-error": true
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
                "options": {
                    "regex": "#^(Merge .+|Revert .+|(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([a-z0-9\\-/]+\\))?!?: [^A-Z].{1,99})#",
                    "error": "Commit message must follow Conventional Commits: type(scope)!: lowercase summary (max 100 chars). See CONTRIBUTING.md"
                }
            }
        ]
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting"
            },
            {
                "action": "vendor/bin/pint --test {$STAGED_FILES|of-type:php}",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\OfType",
                        "args": ["php"]
                    }
                ]
            },
            {
                "action": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G {$STAGED_FILES|of-type:php|in-dir:app}",
                "conditions": [
                    {
                        "exec": "\\CaptainHook\\App\\Hook\\Condition\\FileStaged\\InDirectory",
                        "args": ["app"]
                    }
                ]
            }
        ]
    },
    "pre-push": {
        "enabled": false,
        "actions": []
    }
}
