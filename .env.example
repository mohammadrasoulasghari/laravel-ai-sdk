# =============================================================================
# Application
# Copy to .env (`composer setup` does this) and run `php artisan key:generate`.
# env() is only ever read inside config/*.php — never in app code.
# =============================================================================
APP_NAME="Laravel AI Starter"
# local | testing | staging | production
APP_ENV=local
# Generated by `php artisan key:generate`. Never commit a real key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Default UI locale: fa (RTL) or en (LTR). See config/locales.php.
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC
# Timezone used only for *displaying* dates to users.
APP_DISPLAY_TIMEZONE=Asia/Tehran
APP_MAINTENANCE_DRIVER=file

# Port Sail exposes the app on.
APP_PORT=80
VITE_PORT=5173

BCRYPT_ROUNDS=12

# =============================================================================
# Logging — JSON lines in production (LOG_STACK=json), human-readable locally.
# Every log record carries the request correlation id (X-Request-Id).
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# =============================================================================
# Database — MySQL 8.4 via Sail. PostgreSQL works too (DB_CONNECTION=pgsql).
# Tests use SQLite in-memory locally and MySQL in CI (ADR-0012).
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# =============================================================================
# Session / cache / queue — Redis everywhere outside tests.
# =============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production behind HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log

# =============================================================================
# Files — "local", "public" or "s3" (any S3-compatible: AWS, MinIO, R2, Arvan).
# =============================================================================
FILESYSTEM_DISK=local
UPLOADS_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Mail — Mailpit locally (UI on http://localhost:8025).
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Security
# =============================================================================
# Comma-separated origins allowed to call /api with CORS.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
# Stateful SPA domains for Sanctum (only if you add an SPA).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1
# Personal access token lifetime in minutes (null = never expires).
SANCTUM_TOKEN_EXPIRATION=43200
# Send HSTS header (enable only when the whole domain is HTTPS).
SECURITY_HSTS=false
# Content-Security-Policy in report-only mode first, then enforce.
SECURITY_CSP_REPORT_ONLY=false

# =============================================================================
# Observability
# =============================================================================
TELESCOPE_ENABLED=true
PULSE_ENABLED=true
# Error tracker DSN (e.g. Sentry). Empty = disabled. See docs/observability.md.
ERROR_REPORTING_DSN=

# =============================================================================
# Admin bootstrap (used by DatabaseSeeder in local only)
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
